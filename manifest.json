{
  "manifest_version": 3,
  "name": "Shorts & Reels Blocker",
  "version": "1.1.0",
  "description": "Hides YouTube Shorts and Instagram Reels while keeping ordinary videos, posts, profiles, and messages accessible.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "css": ["instagram.css"],
      "js": ["instagram.js"],
      "run_at": "document_start"
    }
  ]
}
